import puppeteer from 'puppeteer-core';
const CHROME='/Applications/Google Chrome.app/Contents/MacOS/Google Chrome';
const b=await puppeteer.launch({executablePath:CHROME,headless:true,args:['--no-sandbox','--use-gl=angle','--use-angle=swiftshader','--enable-unsafe-swiftshader','--force-device-scale-factor=1','--hide-scrollbars','--mute-audio']});
const p=await b.newPage(); p.on('pageerror',e=>console.log('PAGEERROR',e.message));
await p.setViewport({width:1440,height:900});
await p.goto('file:///Users/yoyopc/repos/kart-project/.tmp/critic/probe.html',{waitUntil:'load'});
await p.waitForFunction('window.__DEBUG&&window.__DEBUG.ready===true',{timeout:60000});
const w=ms=>new Promise(r=>setTimeout(r,ms));
await w(400);
const cards=()=>p.evaluate(()=>[...document.querySelectorAll('.grg-opt')].map(c=>c.querySelector('.grg-opt-he')?.textContent.trim()));
const click=async i=>{await p.evaluate(n=>document.querySelectorAll('.grg-opt')[n].click(),i);await w(350);};
const pill=async i=>{await p.evaluate(n=>document.querySelectorAll('.grg-pill')[n].click(),i);await w(300);};
const sig=()=>p.evaluate(()=>{
  // walk the whole three scene under the garage anchor
  const root=window.__DEBUG?.scene; if(!root) return 'no scene';
  let meshes=0, tris=0, names=[];
  root.traverse(o=>{ if(o.isMesh){meshes++; const g=o.geometry; if(g?.index)tris+=g.index.count/3; else if(g?.attributes?.position)tris+=g.attributes.position.count/3; if(o.name)names.push(o.name);} });
  return {meshes, tris:Math.round(tris), names:names.slice(0,8)};
});
const shot=async n=>{const box={x:26,y:205,width:372,height:235};
  await p.screenshot({path:'/Users/yoyopc/repos/kart-project/shots/critic-garage/k2-'+n+'.png',clip:box});};
async function run(label, partIdx, lvl){
  await p.evaluate(()=>window.__DEBUG.goto('preview',{})); await w(500);
  await click(partIdx);
  for(let s=0;s<3;s++){ const n=(await cards()).length; await click(lvl); }
  const sentence=await p.evaluate(()=>document.querySelector('.grg-sentence .grg-sentence-txt')?.textContent.replace(/\s+/g,' ').trim());
  const q=await p.evaluate(()=>document.querySelector('.grg-quality')?.textContent.trim()||'');
  console.log('\n== '+label, '\n  tiers:',JSON.stringify(await p.evaluate(()=>window.__TIERS)),'\n  sig:',JSON.stringify(await sig()),'\n  sentence:',sentence);
  await shot(label);
}
await run('engine-vague',0,0);
await run('engine-sharp',0,3);
await run('wing-sharp',2,3);
await run('tires-sharp',1,3);
await b.close();
